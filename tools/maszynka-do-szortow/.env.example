# Skopiuj ten plik do .env i wklej swoje dane. .env nigdy nie trafia do gita.

# Klucz ElevenLabs NIE jest juz tutaj potrzebny — zyje w credentialu n8n
# "PM Marketing OS — ElevenLabs". Appka woli n8n zamiast ElevenLabs
# bezposrednio. DONA_N8N_SHARED_SECRET to sekret z tabeli n8n
# PM_sekrety_wspolne (wpis "maszynka_szortow_sekret") — poproś o niego Dona
# albo sprawdz w n8n. Nie jest to klucz ElevenLabs, tylko sekret miedzy tym
# narzedziem a n8n.
DONA_N8N_SHARED_SECRET=

# Zmien tylko jesli odpowiedni webhook n8n zostanie kiedys przeniesiony pod inny adres.
# DONA_N8N_ELEVENLABS_URL=https://pmresearch.app.n8n.cloud/webhook/maszynka-elevenlabs
# DONA_N8N_SCENEGEN_URL=https://pmresearch.app.n8n.cloud/webhook/maszynka-generuj-sceny

# ID glosu z ElevenLabs. Domyslnie glos z biblioteki (Rachel, multilingual).
# Jak sklonujesz swoj glos, wklej tutaj jego ID albo nadpisz per-projekt w panelu.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

PORT=3000
